# Sunucunun alan adı (ör. DuckDNS: benimevim.duckdns.org). Ev IP'ne yönlenmeli.
DOMAIN=uzak.example.com
# İlk açılışta oluşturulacak hesap. Kurulumdan sonra bu iki satırı silebilirsin.
ADMIN_USERNAME=baris
ADMIN_PASSWORD=buraya-guclu-bir-sifre-yaz

# Verilerin tutulacağı klasör (CasaOS için önerilen yol).
DATA_DIR=/DATA/AppData/uzaktan-kontrol

# Web paneli / API portları. CasaOS kendi paneli için 80'i kullanıyorsa
# HTTP_PORT'u başka bir değere çek; sertifika 443 üzerinden alınır.
HTTP_PORT=80
HTTPS_PORT=443
